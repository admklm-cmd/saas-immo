<mxfile host="app.diagrams.net" agent="Ascend Strategy" version="24.0.0"><diagram id="cur" name="1. Actuel - prototype local"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cur_2" value="Ascend Strategy — infrastructure ACTUELLE (prototype sur poste de développement, rien n’est exposé sur Internet) — relevé du 15/10/2026" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="cur_3" value="Poste de développement — Windows 11 Pro · Node.js 24 · Docker Desktop 29.8 (WSL2)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;dashed=1;fillColor=#fafafa;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1080" height="800" as="geometry"/></mxCell><mxCell id="cur_4" value="Navigateur (Chromium)&#xa;http://127.0.0.1:3000&#xa;(utilisateur ou Playwright)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="70" as="geometry"/></mxCell><mxCell id="cur_5" value="Application Next.js 16.3 (App Router, React 19, TypeScript)&#xa;next dev · port 3000&#xa;• proxy.ts : renouvellement de session&#xa;• 21 pages · 10 fichiers de server actions&#xa;• 3 webhooks /api (WhatsApp, SMS, logiciel immo) → HTTP 501&#xa;• en-têtes : CSP, HSTS (prod), X-Frame-Options DENY" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="330" height="140" as="geometry"/></mxCell><mxCell id="cur_6" value="Agents IA (Léa, Hugo, Emma, Louis, Sarah)&#xa;exécution synchrone dans le serveur Next&#xa;fournisseur = SIMULATEUR (aucun appel externe)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="330" height="70" as="geometry"/></mxCell><mxCell id="cur_7" value="Réseau Docker « supabase_network_saas-immo » (supabase start, CLI 2.117)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;dashed=1;fillColor=#eef5ff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="420" height="740" as="geometry"/></mxCell><mxCell id="cur_8" value="Kong 2.8 — passerelle API&#xa;hôte :54321 → conteneur :8000" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="380" height="60" as="geometry"/></mxCell><mxCell id="cur_9" value="GoTrue v2.196 (Auth)&#xa;:9999 · mot de passe ≥ 12 car.&#xa;MFA désactivé (local)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="210" width="180" height="60" as="geometry"/></mxCell><mxCell id="cur_10" value="PostgREST v16.2&#xa;:3000 (interne)&#xa;max 1000 lignes/requête" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="880" y="210" width="180" height="60" as="geometry"/></mxCell><mxCell id="cur_11" value="Realtime v2.130&#xa;:4000 (interne)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="290" width="180" height="50" as="geometry"/></mxCell><mxCell id="cur_12" value="Storage API v1.72&#xa;:5000 (interne)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="880" y="290" width="180" height="50" as="geometry"/></mxCell><mxCell id="cur_13" value="postgres-meta v0.99&#xa;:8080 (interne)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="360" width="180" height="50" as="geometry"/></mxCell><mxCell id="cur_14" value="Studio (admin web)&#xa;hôte :54323" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="880" y="360" width="180" height="50" as="geometry"/></mxCell><mxCell id="cur_15" value="Mailpit (SMTP de test)&#xa;hôte :54324 · aucun envoi réel" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="680" y="430" width="180" height="50" as="geometry"/></mxCell><mxCell id="cur_16" value="PostgreSQL 17.6 — hôte :54322&#xa;• schéma public : 12 tables métier&#xa;• schéma private : 2 tables techniques&#xa;• RLS activée sur les 14 tables · 35 politiques&#xa;• 40 fonctions SQL (RPC SECURITY DEFINER, triggers)&#xa;• Vault : secret HMAC du formulaire d’estimation&#xa;• 17 migrations versionnées" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="720" y="520" width="320" height="190" as="geometry"/></mxCell><mxCell id="cur_17" value="Isolation multi-agences : chaque ligne porte agency_id ;&#xa;RLS + clés étrangères composites ;&#xa;testée avec 2 agences fictives (tests d’intégration)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="730" width="380" height="80" as="geometry"/></mxCell><mxCell id="cur_18" value="Chargeur de données fictives&#xa;(tsx fixtures/load-fixtures.ts)&#xa;clé service_role, base LOCALE uniquement&#xa;2 agences, ~570 contacts sur 24 mois" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="230" height="90" as="geometry"/></mxCell><mxCell id="cur_19" value="Tests automatisés (locaux)&#xa;• Vitest unitaires : ~2 250&#xa;• Vitest intégration (base réelle) : ~520&#xa;• Playwright E2E : ~330 parcours&#xa;• tsc strict + ESLint" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="230" height="110" as="geometry"/></mxCell><mxCell id="cur_20" value="Secrets : .env.local (ignoré par Git)&#xa;URL + clé publique Supabase,&#xa;clé secrète (chargeur uniquement),&#xa;secret HMAC, mots de passe de démo.&#xa;Jamais dans le dépôt." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="230" height="110" as="geometry"/></mxCell><mxCell id="cur_21" value="GitHub — admklm-cmd/saas-immo&#xa;(dépôt actuellement PUBLIC)&#xa;branches feat/* · pull requests&#xa;aucune CI configurée" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="90" width="250" height="90" as="geometry"/></mxCell><mxCell id="cur_22" value="Coffre Obsidian (disque D:)&#xa;notes de contexte et décisions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="200" width="250" height="60" as="geometry"/></mxCell><mxCell id="cur_23" value="Fournisseur IA externe (Anthropic)&#xa;CODÉ mais ÉTEINT&#xa;branche feat/ai-ready · Privacy Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="300" width="250" height="80" as="geometry"/></mxCell><mxCell id="cur_24" value="Intégrations futures&#xa;WhatsApp Business, SMS, Google Calendar,&#xa;Outlook, Hektor / Apimo / Netty&#xa;NON BRANCHÉES" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="400" width="250" height="80" as="geometry"/></mxCell><mxCell id="cur_25" value="Légende&#xa;trait plein = existe et fonctionne&#xa;pointillé / gris = prévu ou désactivé&#xa;orange = point d’entrée réseau&#xa;violet = code applicatif · bleu = données&#xa;rouge = accès privilégié (local)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1140" y="520" width="250" height="120" as="geometry"/></mxCell><mxCell id="cur_26" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_4" target="cur_5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_27" value="REST + Auth (supabase-js,&#xa;cookies de session)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_5" target="cur_8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_28" value="appel interne" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_5" target="cur_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_8" target="cur_9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_8" target="cur_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_8" target="cur_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_8" target="cur_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_33" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_9" target="cur_16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_34" value="SQL + RLS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_10" target="cur_16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_13" target="cur_16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_14" target="cur_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_37" value="API admin (local)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cur_18" target="cur_8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_38" value="git push (manuel)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="cur_5" target="cur_21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cur_39" value="désactivé" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#999999;" edge="1" parent="1" source="cur_6" target="cur_23"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tgt" name="2. Cible - production VPS (prévue)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tgt_2" value="Ascend Strategy — architecture CIBLE de production (NON déployée — prérequis dans docs/security.md et docs/audits/2026-10-10)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="tgt_3" value="Utilisateurs&#xa;• visiteurs (site public, estimation)&#xa;• conseillers / direction d’agence&#xa;(navigateur, HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="120" width="180" height="100" as="geometry"/></mxCell><mxCell id="tgt_4" value="DNS + certificat TLS&#xa;(Let’s Encrypt)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="240" y="140" width="150" height="60" as="geometry"/></mxCell><mxCell id="tgt_5" value="VPS Linux (hébergeur UE à choisir) — pare-feu : 443 ouvert, 80 → redirection, 22 restreint (clé SSH + IP)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;dashed=1;fillColor=#fafafa;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="430" y="70" width="640" height="560" as="geometry"/></mxCell><mxCell id="tgt_6" value="nginx — reverse proxy&#xa;• terminaison TLS, HSTS&#xa;• limitation de débit (formulaire public, /connexion)&#xa;• transmet l’IP réelle (TRUSTED_PROXY_HOPS = 1)&#xa;• filtrage de base" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="460" y="120" width="280" height="110" as="geometry"/></mxCell><mxCell id="tgt_7" value="Next.js (build de production)&#xa;node, service systemd ou conteneur&#xa;CSP stricte (nonce à faire), HSTS&#xa;variables d’environnement serveur" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="780" y="120" width="270" height="110" as="geometry"/></mxCell><mxCell id="tgt_8" value="Worker de tâches (À CRÉER)&#xa;file durable « outbox », idempotence,&#xa;reprises bornées, dead-letter" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="780" y="260" width="270" height="90" as="geometry"/></mxCell><mxCell id="tgt_9" value="Privacy Gateway (dans le serveur)&#xa;pseudonymisation, liste blanche par agent,&#xa;refus au moindre doute, plafond d’appels/jour" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="260" width="280" height="90" as="geometry"/></mxCell><mxCell id="tgt_10" value="Journaux &amp; supervision (À CRÉER)&#xa;logs structurés expurgés, métriques,&#xa;alertes, journal des accès sensibles" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="460" y="380" width="280" height="80" as="geometry"/></mxCell><mxCell id="tgt_11" value="Sauvegardes (À CRÉER)&#xa;chiffrées, hors site, test de restauration&#xa;objectifs RPO / RTO à fixer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="780" y="380" width="270" height="80" as="geometry"/></mxCell><mxCell id="tgt_12" value="Déjà couvert par le code :&#xa;RLS par agence en base · session revérifiée côté serveur · empreinte IP signée (HMAC) sur le formulaire public ·&#xa;changements d’étape tracés par RPC · pas d’e-mail ni de téléphone envoyé au navigateur sans besoin ·&#xa;secrets uniquement en variables serveur · aucun service_role dans un chemin utilisateur." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="460" y="490" width="590" height="120" as="geometry"/></mxCell><mxCell id="tgt_13" value="Supabase managé — région UE (recommandé pour le pilote)&#xa;• Postgres 17 + RLS (14 tables)&#xa;• Auth (MFA à activer)&#xa;• PostgREST / Storage&#xa;• Vault (secrets côté base)&#xa;• sauvegardes de l’offre + PITR selon plan&#xa;&#xa;Alternative : auto-hébergement sur le VPS&#xa;(⇒ correctifs, haute dispo, sauvegardes à notre charge)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1110" y="70" width="300" height="250" as="geometry"/></mxCell><mxCell id="tgt_14" value="Fournisseur IA (Anthropic ou autre)&#xa;UNIQUEMENT via la Privacy Gateway&#xa;activation = décision + budget + DPA" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1110" y="350" width="300" height="90" as="geometry"/></mxCell><mxCell id="tgt_15" value="Canaux sortants (futurs)&#xa;WhatsApp Business, SMS (Twilio / Brevo),&#xa;Google Calendar, Outlook — via le worker" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1110" y="470" width="300" height="90" as="geometry"/></mxCell><mxCell id="tgt_16" value="Logiciels immobiliers (futurs)&#xa;Hektor, Apimo, Netty — webhooks entrants signés" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1110" y="590" width="300" height="70" as="geometry"/></mxCell><mxCell id="tgt_17" value="GitHub (dépôt privé)&#xa;CI à créer : tsc, lint, tests&#xa;avant déploiement" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="180" height="90" as="geometry"/></mxCell><mxCell id="tgt_18" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tgt_3" target="tgt_4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tgt_19" value="443" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tgt_4" target="tgt_6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tgt_20" value="HTTP local" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tgt_6" target="tgt_7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tgt_21" value="HTTPS (clé publique +&#xa;session utilisateur)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tgt_7" target="tgt_13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="tgt_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tgt_7" target="tgt_9"><mxGeometry relat