# Copy to .env.local and fill in. Never commit real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser: never put a secret in them.

# --- Supabase (public, browser-safe) ---
# Local dev: values printed by `npx supabase status` (API URL, Publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (server only, bypasses RLS) ---
# Secret key (sb_secret_...) or legacy service_role key.
# Used only by lib/supabase/admin.ts for restricted server tasks (e.g. local fixtures loader).
SUPABASE_SECRET_KEY=

# --- Local fixtures (optional, development only) ---
# Passwords of the three fictitious demo accounts loaded by `npm run db:seed`.
# Leave empty to get a strong random password written to
# fixtures/.generated-credentials.json (git-ignored). Minimum 12 characters.
FIXTURES_PASSWORD_DIRECTOR_A=
FIXTURES_PASSWORD_AGENT_A=
FIXTURES_PASSWORD_USER_B=

# --- Product AI agents (Lea, Hugo, Emma, Louis, Sarah) ---
# "simulator" only for the prototype: no paid AI API call is made.
AI_PROVIDER=simulator

# --- Public estimation form (/estimation) ---
# REQUIRED (no default, no fallback). Server-only secret used to salt the
# SHA-256 hash of a visitor's IP address before it is sent to the database for
# rate limiting (the raw IP is never stored).
# Generate one with: openssl rand -hex 32
# Minimum accepted length: 32 characters (see MIN_IP_HASH_SALT_LENGTH in
# features/estimation/ip-hash.ts). If it is missing, empty or shorter than
# that, /estimation stores NOTHING at all (no request, no consent, no
# rate-limit row) and returns a generic "service unavailable" message to the
# visitor, with an explicit reason logged server-side. This is deliberate: a
# hard-coded fallback salt would be public and would make every stored IP
# hash brute-forceable.
ESTIMATION_IP_HASH_SALT=
